  "components": {
    "schemas": {
      "Analysis": {
        "properties": {
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/Requirement"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 1,
            "title": "Requirements"
          },
          "missing": {
            "items": {
              "type": "string",
              "maxLength": 1400,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "title": "Missing"
          },
          "assumptions": {
            "items": {
              "type": "string",
              "maxLength": 1400,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "title": "Assumptions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requirements",
          "missing",
          "assumptions"
        ],
        "title": "Analysis"
      },
      "Architecture": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "style": {
            "type": "string",
            "enum": [
              "monolith",
              "microservices",
              "event-driven"
            ],
            "title": "Style"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/Component"
            },
            "type": "array",
            "maxItems": 24,
            "minItems": 1,
            "title": "Components"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/Edge"
            },
            "type": "array",
            "maxItems": 48,
            "title": "Edges"
          },
          "endpoints": {
            "items": {
              "$ref": "#/components/schemas/Endpoint"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Endpoints"
          },
          "tables": {
            "items": {
              "$ref": "#/components/schemas/Table"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Tables"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "style",
          "components",
          "edges",
          "endpoints",
          "tables"
        ],
        "title": "Architecture"
      },
      "Brief": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 12,
            "title": "Text"
          },
          "style": {
            "type": "string",
            "enum": [
              "monolith",
              "microservices",
              "event-driven"
            ],
            "title": "Style",
            "default": "microservices"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Brief"
      },
      "Citation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "passage": {
            "type": "string",
            "title": "Passage"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "passage"
        ],
        "title": "Citation"
      },
      "CompareResult": {
        "properties": {
          "diff": {
            "additionalProperties": true,
            "type": "object",
            "title": "Diff"
          },
          "left": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "title": "Left"
          },
          "right": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "title": "Right"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "diff",
          "left",
          "right"
        ],
        "title": "CompareResult"
      },
      "Comparison": {
        "properties": {
          "left": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Left"
          },
          "right": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Right"
          },
          "right_run": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 36
              },
              {
                "type": "null"
              }
            ],
            "title": "Right Run"
          },
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "left",
          "right",
          "scenario"
        ],
        "title": "Comparison"
      },
      "Component": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 90,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "gateway",
              "service",
              "database",
              "queue",
              "worker"
            ],
            "title": "Kind"
          },
          "technology": {
            "type": "string",
            "maxLength": 1400,
            "minLength": 1,
            "title": "Technology"
          },
          "rationale": {
            "type": "string",
            "maxLength": 1400,
            "minLength": 1,
            "title": "Rationale"
          },
          "requirements": {
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,39}$"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Requirements"
          },
          "replicas": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Replicas",
            "default": 1
          },
          "slots": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Slots",
            "default": 2
          },
          "service_ms": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 1.0,
            "title": "Service Ms",
            "default": 40
          },
          "monthly_usd": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Monthly Usd",
            "default": 40
          },
          "x": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "X",
            "default": 0
          },
          "y": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": -10000.0,
            "title": "Y",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "technology",
          "rationale"
        ],
        "title": "Component"
      },
      "Edge": {
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$",
            "title": "Target"
          },
          "mode": {
            "type": "string",
            "enum": [
              "sync",
              "async"
            ],
            "title": "Mode",
            "default": "sync"
          },
          "protocol": {
            "type": "string",
            "maxLength": 1400,
            "minLength": 1,
            "title": "Protocol",
            "default": "HTTPS"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "title": "Edge"
      },
      "Endpoint": {
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ],
            "title": "Method"
          },
          "path": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^/[a-zA-Z0-9/{}_\\-]*$",
            "title": "Path"
          },
          "purpose": {
            "type": "string",
            "maxLength": 1400,
            "minLength": 1,
            "title": "Purpose"
          },
          "request": {
            "type": "string",
            "maxLength": 1400,
            "minLength": 1,
            "title": "Request"
          },
          "response": {
            "type": "string",
            "maxLength": 1400,
            "minLength": 1,
            "title": "Response"
          }
        },
        "additionalProperties": false,
